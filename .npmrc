# Keep devDependencies (typescript, @types/*) installed even when NODE_ENV=production
# is set in the environment — required because the build (next build, triggered
# automatically via the "postinstall" script) needs the TypeScript compiler and
# type packages. Without this, `npm install` run under NODE_ENV=production would
# silently skip devDependencies and the build would fail.
production=false

# tailwindcss-animate declares a peer dep on tailwindcss (>=3.0.0), which is
# satisfied by our pinned tailwindcss@3.4.4 — but npm's strict ERESOLVE check
# can still reject it on some hosts/npm versions, especially after a prior
# interrupted/corrupted install left a stale node_modules/tailwindcss behind.
# Skip strict peer-dep resolution so "Run NPM Install" on cPanel doesn't fail.
legacy-peer-deps=true
