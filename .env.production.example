# EmpowerHub — متغيرات البيئة للإنتاج على استضافة cPanel المشتركة (empowerhub.tech)
#
# انسخ هذا الملف إلى .env (نفس مجلد تطبيق Node.js على السيرفر) واملأ القيم،
# أو أدخلها واحدة واحدة من شاشة "Setup Node.js App" في cPanel (Environment Variables).
# لا ترفع هذا الملف لقائم بقيم حقيقية إلى GitHub.

# ── عام ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# cPanel's Node.js Selector (Passenger) sets PORT تلقائياً عند إنشاء التطبيق —
# لا تحدده يدوياً إلا إذا طلبت الاستضافة ذلك صراحة.
# PORT=3000

# إلزامي إذا رافعين المشروع كامل (الكود المصدري) وبتضغطوا "Run NPM Install"
# من واجهة cPanel عشان يبني المشروع تلقائياً — راجع DEPLOYMENT.md. بدون هذا
# المتغير، npm install بيثبّت الحزم بس بدون ما يبني next build.
CPANEL_AUTOBUILD=1

# ── قاعدة البيانات (MySQL — إلزامي) ──────────────────────────────────────
# هذه القيم موجودة أصلاً في شاشة "Setup Node.js App" → Environment Variables
# لأي قاعدة MySQL أنشأتها من cPanel (MySQL Databases). DB_SOCKET هو الطريق
# الموصى به على نفس السيرفر (أسرع من DB_HOST/DB_PORT عبر TCP)؛ إذا غير متوفر
# احذفه واستخدم DB_HOST (localhost عادة) وDB_PORT (3306) بدلاً منه.
DB_NAME=empowerhub_app
DB_USER=empowerhub_app
DB_PASSWORD=غيّر-هذه-القيمة-لكلمة-مرور-قاعدة-البيانات
DB_SOCKET=/var/lib/mysql/mysql.sock
# DB_HOST=localhost
# DB_PORT=3306

# ── المصادقة (JWT — إلزامي) ───────────────────────────────────────────────
# يُستخدم لتوقيع وفحص رموز تسجيل الدخول (JWT) بدلاً من Firebase Auth.
# اختر قيمة سرية عشوائية طويلة وقوية، ولا تغيّرها بعد النشر (تغييرها يسجّل
# خروج كل المستخدمين فوراً لأن كل الرموز الحالية تصبح غير صالحة).
JWT_SECRET=غيّر-هذه-القيمة-لقيمة-عشوائية-طويلة-جداً

# ── تخزين الملفات المرفوعة (إلزامي) ───────────────────────────────────────
# مسار مطلق على السيرفر خارج مجلد البناء (next-build/) تماماً، لأن next-build/
# يُستبدل بالكامل عند كل نشر جديد وأي ملفات بداخله ستُفقد. مثال: مجلد شقيق
# لمجلد تطبيق Node.js نفسه (وليس بداخله إذا كان داخل next-build).
UPLOADS_DIR=/home/username/empowerhub-uploads

# ── مهام الفحص اليومي (الاشتراكات) ──────────────────────────────────────
# يُستخدم في src/app/api/cron/check-subscriptions/route.ts للتحقق من هوية
# المستدعي (GitHub Action أو Cron Job من cPanel). اختر قيمة سرية عشوائية قوية.
CRON_SECRET=غيّر-هذه-القيمة-لقيمة-عشوائية-طويلة
