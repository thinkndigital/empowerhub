rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    // Read role directly from JWT custom claims (no extra Firestore read → no recursion)
    function role()     { return request.auth.token.get('role', ''); }
    function orgId()    { return request.auth.token.get('organizationId', ''); }

    function isAdmin()        { return role() == 'admin'; }
    function isOrg()          { return role() == 'organization'; }
    function isMentor()       { return role() == 'mentor'; }
    function isCoach()        { return role() == 'coach'; }
    function isBeneficiary()  { return role() == 'beneficiary'; }
    function isStaff()        { return isAdmin() || isOrg() || isMentor() || isCoach(); }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Everyone signed-in can read profiles (needed for listings, chat, dashboards)
      allow read: if signedIn();

      // Own registration / login profile creation
      allow create: if signedIn() && uid() == userId;

      // Own profile edits, admins, org admins, mentors, coaches can edit their users
      allow update: if signedIn() && (
        uid() == userId ||
        isAdmin() ||
        isOrg() ||
        isMentor() ||
        isCoach()
      );

      allow delete: if isAdmin();
    }

    // ── organizations ─────────────────────────────────────────────────────────
    match /organizations/{organizationId} {
      allow read: if signedIn();

      // Any signed-in user can create (org admin self-registers)
      allow create: if signedIn();

      // Org admin (their token orgId matches doc) or platform admin
      allow update: if signedIn() && (
        isAdmin() ||
        (isOrg() && orgId() == organizationId)
      );

      allow delete: if isAdmin();
    }

    // ── courses ───────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if signedIn();

      allow create: if signedIn() && (isAdmin() || isOrg() || isCoach());

      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        (isCoach() && resource.data.createdBy == uid())
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        (isCoach() && resource.data.createdBy == uid())
      );

      // course modules sub-collection
      match /modules/{moduleId} {
        allow read: if signedIn();
        allow write: if signedIn() && (isAdmin() || isOrg() || isCoach());
      }
    }

    // ── courseProgress ────────────────────────────────────────────────────────
    match /courseProgress/{progressId} {
      allow read: if signedIn() && (
        isAdmin() || isOrg() || isMentor() || isCoach() ||
        resource.data.userId == uid()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin() || resource.data.userId == uid()
      );
      allow delete: if isAdmin();
    }

    // ── sessions ──────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn() && (isAdmin() || isOrg() || isMentor() || isCoach());

      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.hostId == uid() ||
        resource.data.mentorId == uid()
      );

      allow delete: if isAdmin() || isOrg();
    }

    // ── products ──────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public marketplace — anyone can read
      allow read: if true;

      allow create: if signedIn();

      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.ownerId == uid()
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.ownerId == uid()
      );
    }

    // ── stores ────────────────────────────────────────────────────────────────
    match /stores/{storeId} {
      allow read: if true;

      allow create: if signedIn();

      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.ownerId == uid()
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.ownerId == uid()
      );
    }

    // ── orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn();

      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.beneficiaryId == uid() ||
        resource.data.customerId == uid()
      );

      allow delete: if isAdmin();
    }

    // ── conversations & messages ───────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if signedIn() && (
        isAdmin() ||
        request.auth.uid in resource.data.participants
      );
      allow list: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin() ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if signedIn() && resource.data.senderId == uid();
        allow delete: if isAdmin();
      }
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Each user reads their own; admins read all
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == uid()
      );
      allow list: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.userId == uid()
      );
      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.userId == uid()
      );
    }

    // ── orgInvitations ────────────────────────────────────────────────────────
    match /orgInvitations/{inviteId} {
      allow read: if signedIn();
      allow list: if signedIn();

      // Org admins (and platform admins) create invitations
      allow create: if signedIn() && (isAdmin() || isOrg());

      // Target user accepts/rejects; org admin or platform admin can also update
      allow update: if signedIn() && (
        isAdmin() ||
        isOrg() ||
        resource.data.targetUid == uid()
      );

      allow delete: if signedIn() && (isAdmin() || isOrg());
    }

    // ── groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn() && (isAdmin() || isOrg());
      allow update: if signedIn() && (isAdmin() || isOrg());
      allow delete: if signedIn() && (isAdmin() || isOrg());
    }

    // ── evaluations ───────────────────────────────────────────────────────────
    match /evaluations/{evalId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin() || isOrg();
      allow delete: if isAdmin();
    }

    // ── contactRequests ───────────────────────────────────────────────────────
    match /contactRequests/{reqId} {
      allow create: if signedIn();
      allow read: if signedIn() && (isAdmin() || isOrg());
      allow update, delete: if isAdmin();
    }

    // ── settings (platform-wide) ──────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

  }
}
